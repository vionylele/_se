# Copy to .env and adjust:  cp .env.example .env
# Every value has a default in docker-compose.yml, so .env is optional for a local demo.

# --- PostgreSQL ---
POSTGRES_USER=sensor_user
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=sensors
# NOTE: these are only applied when the database volume is first created.
# Changing them later needs `docker compose down -v` (this DELETES stored data).

# --- Nginx ---
# Host port that serves the dashboard (container port stays 80).
HTTP_PORT=80

# --- Backend ---
# Readings older than this many hours are deleted by a background job.
RETENTION_HOURS=24

# --- Simulator ---
SIM_MIN_INTERVAL_MS=3000
SIM_MAX_INTERVAL_MS=5000
