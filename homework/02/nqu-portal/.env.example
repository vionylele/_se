# Copy this file to ".env.local" for local development (never commit the real file).
# Supabase Dashboard -> Project Settings -> API (or "Connect")

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://ktfizgafwmqguiaaszsx.supabase.co

# The publishable / anon key. It is designed to be public (browser-safe); Row Level Security protects the data.
# NEVER put the secret / service_role key in a VITE_ variable: Vite bundles it into the public site.
VITE_SUPABASE_ANON_KEY=sb_publishable_SEq43D0tLSS5wu-njKs-uw_b6pTOux6
