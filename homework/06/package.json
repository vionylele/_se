{
  "name": "clinic-system-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Homework 06 - 3-tier test suite (unit, system/API, E2E) for homework/03/Clinic_System",
  "type": "module",
  "scripts": {
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:system": "vitest run --config vitest.config.ts tests/system",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:system && npm run test:e2e",
    "test:e2e:headed": "playwright test --headed",
    "test:report": "node scripts/run-and-report.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@supabase/supabase-js": "2.45.4",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "http-server": "^14.1.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": { "node": ">=18" }
}
